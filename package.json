{
  "name": "env-doctor",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript-first environment variable validator with beautiful terminal output",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    }
  },
  "bin": {
    "env-doctor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "env",
    "environment",
    "dotenv",
    "validation",
    "schema",
    "typescript",
    "cli",
    "config",
    "process-env",
    "zero-dependency",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajju853/env-doctor.git"
  },
  "license": "MIT",
  "author": "ajju853 <ajju853@users.noreply.github.com>",
  "homepage": "https://github.com/ajju853/env-doctor#readme",
  "bugs": {
    "url": "https://github.com/ajju853/env-doctor/issues"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
